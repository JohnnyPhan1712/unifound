@startuml UniFoundUseCase
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Khách\n(chưa đăng nhập)" as KH
actor "Sinh viên" as SV
actor "Quản trị viên" as AD

SV --|> KH

rectangle "Hệ thống UniFound" {
  usecase "Xem bảng tin" as UC01
  usecase "Tìm kiếm & lọc tin" as UC02
  usecase "Xem chi tiết tin" as UC03
  usecase "Đăng nhập / Đăng ký\nbằng email sinh viên" as UC04

  usecase "Đăng tin mất đồ" as UC05
  usecase "Đăng tin nhặt được" as UC06
  usecase "Tải ảnh đồ vật" as UC07
  usecase "Xem gợi ý tin phù hợp" as UC08

  usecase "Gửi yêu cầu nhận đồ" as UC09
  usecase "Trả lời câu hỏi xác minh" as UC10
  usecase "Duyệt / từ chối yêu cầu" as UC11
  usecase "Hẹn điểm gặp &\nxác nhận bàn giao" as UC12

  usecase "Quản lý tin của tôi" as UC13
  usecase "Xem thông báo" as UC14
  usecase "Báo cáo tin vi phạm" as UC15

  usecase "Duyệt / ẩn tin" as UC16
  usecase "Xử lý báo cáo vi phạm" as UC17
  usecase "Quản lý danh mục & địa điểm" as UC18
  usecase "Xem thống kê" as UC19
  usecase "Khóa / mở khóa tài khoản" as UC20
}

KH --> UC01
KH --> UC02
KH --> UC03
KH --> UC04

SV --> UC05
SV --> UC06
SV --> UC08
SV --> UC09
SV --> UC11
SV --> UC12
SV --> UC13
SV --> UC14
SV --> UC15

UC05 ..> UC07 : <<include>>
UC06 ..> UC07 : <<include>>
UC09 ..> UC10 : <<include>>
UC08 ..> UC05 : <<extend>>
UC08 ..> UC06 : <<extend>>
UC12 ..> UC11 : <<extend>>

AD --> UC16
AD --> UC17
AD --> UC18
AD --> UC19
AD --> UC20
@enduml
